# ----------------------------------------------------------------------------
# Ausleihsystem – Beispielkonfiguration
#
# Kopiere diese Datei nach `.env` und passe die Werte an deine Umgebung an:
#   cp .env.example .env
# ----------------------------------------------------------------------------

# ---- Datenbank ----
# Verbindungs-String zu PostgreSQL.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ausleihsystem?schema=public"

# ---- Öffentliche Domain (für Links in E-Mails etc.) ----
DOMAIN="http://localhost:3000"

# ---- E-Mail-Versand (SMTP) ----
# Setze auf TRUE, um den E-Mail-Versand komplett zu deaktivieren (z.B. in Dev).
ES_DISABLED=TRUE

# SMTP-Zugangsdaten – nur nötig, wenn ES_DISABLED nicht TRUE ist.
ES_HOST=
ES_USER=
ES_PASSWORD=
# TRUE => TLS auf Port 465, sonst STARTTLS auf Port 587
ES_SECURE=FALSE

# Empfänger-Adresse für Team-Benachrichtigungen (z.B. neue Anmeldungen).
ES_AUSLEIHE_TEAM=

# ---- Logging ----
# error | warn | info | debug
VITE_LOG_LEVEL=info
