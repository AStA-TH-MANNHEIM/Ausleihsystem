{
	"name": "ausleihsystem",
	"version": "0.0.1",
	"description": "Digitale Bestands- und Ausleihverwaltung für studentische Gremien (SvelteKit + Prisma + PostgreSQL).",
	"license": "MIT",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"postinstall": "if [ \"$PRISMA_SKIP_GENERATE\" != \"true\" ]; then prisma generate; fi",
		"build": "prisma generate &&vite build",
		"clean": "rm -rf build .svelte-kit",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"lint": "prettier -c . && eslint .",
		"lint:stylish": "eslint . --format stylish",
		"lint:codeframe": "eslint . --format codeframe",
		"prettier:check": "prettier -c .",
		"prettier:fix": "prettier --write .",
		"prisma-schema-update": "prisma generate && prisma migrate deploy",
		"vercel-pull-env": "vercel env pull .env",
		"prisma-studio": "prisma studio",
		"start:prod": "node build",
		"start:prod:migrate": "prisma migrate deploy && npm run start:prod",
		"create-admin": "node scripts/create-admin.js"
	},
	"devDependencies": {
		"@iconify/svelte": "^4.0.2",
		"@skeletonlabs/skeleton": "^2.10.1",
		"@skeletonlabs/tw-plugin": "^0.4.0",
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^3.0.0",
		"@tailwindcss/forms": "^0.5.7",
		"@tailwindcss/typography": "^0.5.13",
		"@types/eslint": "^8.56.0",
		"@types/node": "^20.14.10",
		"@types/uuid": "^10.0.0",
		"@typescript-eslint/eslint-plugin": "^7.0.0",
		"@typescript-eslint/parser": "^7.0.0",
		"autoprefixer": "^10.4.19",
		"clsx": "^2.1.1",
		"dotenv": "^17.2.3",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.35.1",
		"eslint-plugin-unused-imports": "^4.1.4",
		"nodemailer": "^6.9.13",
		"postcss": "^8.4.39",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.1.2",
		"prettier-plugin-tailwindcss": "^0.6.4",
		"svelte": "^4.2.7",
		"svelte-check": "^3.6.0",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^3.4.4",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"vite": "^5.0.3",
		"vitest": "^1.2.0",
		"zod": "^3.23.8"
	},
	"type": "module",
	"dependencies": {
		"@floating-ui/dom": "^1.6.10",
		"@lucia-auth/adapter-prisma": "^4.0.1",
		"@node-rs/argon2": "^2.0.2",
		"@prisma/client": "^5.22.0",
		"@sveltejs/adapter-node": "^5.2.9",
		"@types/nodemailer": "^6.4.15",
		"@types/pdfmake": "^0.2.12",
		"@vercel/postgres": "^0.9.0",
		"@vincjo/datatables": "^1.14.10",
		"better-sqlite3": "^9.6.0",
		"bits-ui": "^0.21.16",
		"lucia": "^3.2.0",
		"pdfmake": "^0.2.20",
		"prisma": "^5.17.0",
		"shadcn-svelte": "^0.14.3",
		"svelte-i18n": "^4.0.1",
		"svelte-persisted-store": "^0.11.0",
		"uuid": "^10.0.0",
		"zod-prisma-types": "^3.1.8"
	}
}
